<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-independent filesystem model, scanning, layout, picking, selection and shell actions.
       Must not reference Godot so it can be tested on its own (see docs/architecture.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>FileScape.Core</RootNamespace>
    <!-- A release must not carry the build machine's paths (2026-11-15 publication review). -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/src/FileScape.Core/</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
