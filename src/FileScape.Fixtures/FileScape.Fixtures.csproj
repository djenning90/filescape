<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds and removes the on-disk Windows edge-case fixture. Library for tests, console for manual use. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FileScape.Fixtures</RootNamespace>
    <!-- No native launcher: MSBuild intermittently gets "access denied" copying apphost.exe onto the \\wsl.localhost
         share (docs/windows-workflow.md). Run with: dotnet FileScape.Fixtures.dll -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- create-sky writes the Starter Sky sample (FileScape.Core.Samples.SampleSky). -->
    <ProjectReference Include="..\FileScape.Core\FileScape.Core.csproj" />
  </ItemGroup>
</Project>
