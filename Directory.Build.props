<Project>
  <!-- Windows and WSL builds share this source tree. Separate output folders stop their restore/build state
       (absolute paths differ: /home/... vs \\wsl.localhost\...) from clobbering each other. See docs/windows-workflow.md. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj.win\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)\bin.win\</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Each host must ignore the other host's generated sources. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;obj.win/**;bin.win/**</DefaultItemExcludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- CA1515/CA1711 etc. conflict with a small app's public-by-default types; keep the useful defaults. -->
    <NoWarn>$(NoWarn);CA1515;CA1711;CA1716;CA1720;CA1724;CA1805;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1819;CA1822;CA1848;CA2201;CA1031;CA1002;CA1051;CA1034;CA1815;CA1814;CA5394;CA1859;CA1861;CA1032;CA1064;CA1806;CA1854;CA1311;CA1304;CA2000;CA1508</NoWarn>
  </PropertyGroup>
</Project>
