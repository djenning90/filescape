<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- The Godot application: visualization, interaction, and UI. Filesystem, layout and picking live in FileScape.Core. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>FileScape.App</RootNamespace>
    <AssemblyName>FileScape.App</AssemblyName>
    <!-- Godot resources are engine reference-counted; CA1001 disposal advice does not apply. Async void _Ready is Godot idiom. -->
    <NoWarn>$(NoWarn);CA1001;CA2007;CA1063;CA1816</NoWarn>
    <!-- A release must not carry the build machine's paths (2026-11-15 publication review): source and PDB paths are mapped. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/app/</PathMap>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\FileScape.Core\FileScape.Core.csproj" />
  </ItemGroup>
</Project>
