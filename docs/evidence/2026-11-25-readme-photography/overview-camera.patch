+using Godot;
+namespace FileScape.App.Planets;
+/// <summary>Camera-only framing in the isolated README photography checkout; not a shipping feature.</summary>
+public partial class PlanetWorld
+{
+    public void PhotoFrameUniverse(int id, float systems, float yaw, float pitch)
+    {
+        var i = _uniBodies.FindIndex(b => b.Body.NodeId == id);
+        if (i < 0) return;
+        _uniFocus = _uniFocusTarget = _uniBodies[i].At;
+        _uniDistance = _uniDistanceTarget = SystemSize(_uniBodies[i].Body) * systems;
+        _uniYaw = yaw;
+        _uniPitch = pitch;
+    }
+
+    public IEnumerable<Transform3D> PhotoRingViews(int id)
+    {
+        var centre = _uniBodies.First(b => b.Body.NodeId == id);
+        var n = centre.Body.OrbitNormal;
+        var up = new Vector3(n.X, n.Y, n.Z).Normalized();
+        var kids = _uniBodies.Where(b => b.Body.ParentId == id).ToList();
+        for (var i = 0; i < kids.Count; i += Math.Max(1, kids.Count / 6))
+        {
+            var child = kids[i];
+            var outward = (child.At - centre.At).Normalized();
+            foreach (var near in new[] { 3f, 6f })
+            {
+                var at = child.At + outward * child.Body.Radius * near + up * child.Body.Radius * 2.5f;
+                var target = centre.At + (child.At - centre.At) * .18f;
+                yield return new Transform3D(Basis.LookingAt(target - at, up), at);
+            }
+        }
+    }
+}
