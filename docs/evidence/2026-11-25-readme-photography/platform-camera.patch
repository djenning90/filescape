+using Godot;
+namespace FileScape.App.Planets;
+/// <summary>Camera-only framing in the isolated README photography checkout; not a shipping feature.</summary>
+public partial class PlanetWorld
+{
+    public void PhotoFrameUniverse(int id, float systems, float yaw, float pitch)
+    {
+        var i = _uniBodies.FindIndex(b => b.Body.NodeId == id);
+        if (i < 0) return;
+        _uniFocus = _uniFocusTarget = _uniBodies[i].At;
+        _uniDistance = _uniDistanceTarget = SystemSize(_uniBodies[i].Body) * systems;
+        _uniYaw = yaw;
+        _uniPitch = pitch;
+    }
+}
