+using Godot;
+using FileScape.App.Planets;
+namespace FileScape.App;
+/// <summary>Disposable camera-only README photography harness; worlds and rendering are the released implementation.</summary>
+public partial class PlanetsProbe
+{
+    private async Task PhotographyRun()
+    {
+        await Until(() => App.Tree is { Count: > 1 } && P.Composition != null && !P.Busy, 40);
+        await Seconds(4);
+        var root = App.Navigator.Current;
+        var rig = new ReadmePhotoRig { ProcessPriority = 1000, AppRoot = App, Camera = P.Camera };
+        App.AddChild(rig);
+        foreach (var name in new[] { "Garden Photos", "Music Box", "Lantern Workshop" })
+        {
+            rig.Release();
+            var id = Child(root, name);
+            if (id < 0) continue;
+            await GoToPath(Tree.FullPath(id));
+            await WaitSettled();
+            await Seconds(4);
+            var ov = P.Composition!.Overlook;
+            P.ProbeStandOn(ov.Direction, ov.Top);
+            await Seconds(1);
+            var u = P.Walker.Up; var f = P.Walker.Feet;
+            var up = new Vector3(u.X, u.Y, u.Z); var feet = new Vector3(f.X, f.Y, f.Z);
+            var right = up.Cross(Vector3.Forward).Normalized();
+            var forward = right.Cross(up).Normalized();
+            for (var i = 0; i < 8; i++)
+            {
+                var angle = i * Mathf.Tau / 8;
+                var across = right * Mathf.Sin(angle) + forward * Mathf.Cos(angle);
+                var at = feet + up * 2.8f + across * 8.5f;
+                rig.Pose = new Transform3D(Basis.LookingAt(feet + up * .8f - at, up), at);
+                rig.Fov = 58; rig.HideHud = true;
+                await Seconds(.45);
+                await Shot("platform-" + name.Replace(' ', '-') + "-" + i);
+            }
+        }
+        rig.Release();
+        await GoToPath(Tree.FullPath(root));
+        await WaitSettled(); await Seconds(3);
+        await Key(Godot.Key.T); await Until(() => P.UniverseOpen, 8); await Seconds(8);
+        for (var i = 0; i < 12; i++)
+        {
+            rig.Release();
+            P.PhotoFrameUniverse(root, i < 4 ? .3f : i < 8 ? .45f : .65f, i % 4 * Mathf.Pi / 2 + .55f, .35f);
+            await Seconds(.65);
+            rig.HideHud = true; await Frames(4);
+            await Shot("universe-mixed-" + i);
+        }
+        rig.Release();rig.QueueFree();
+    }
+}
+
+/// <summary>Applies a photographic camera after the game tick; temporarily hides existing CanvasLayers without editing pixels.</summary>
+public partial class ReadmePhotoRig : Node
+{
+    public Main AppRoot = null!;
+    public Camera3D Camera = null!;
+    public Transform3D? Pose;
+    public float Fov = 55;
+    public bool HideHud;
+    private readonly Dictionary<CanvasLayer, bool> _visible = new();
+    public override void _Process(double delta)
+    {
+        if (Pose is { } pose) { Camera.GlobalTransform = pose; Camera.Fov = Fov; }
+        if (HideHud) HideLayers(AppRoot);
+    }
+    private void HideLayers(Node node)
+    {
+        if (node is CanvasLayer layer)
+        {
+            if (!_visible.ContainsKey(layer)) _visible[layer] = layer.Visible;
+            layer.Visible = false;
+        }
+        foreach (var child in node.GetChildren()) HideLayers(child);
+    }
+    public void Release()
+    {
+        Pose = null;
+        HideHud = false;
+        foreach (var (layer, visible) in _visible) if (GodotObject.IsInstanceValid(layer)) layer.Visible = visible;
+        _visible.Clear();
+    }
+}
